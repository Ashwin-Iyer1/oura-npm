{
  "name": "oura-stats-visualizer",
  "version": "0.3.1",
  "description": "Plug-and-play Oura stats visualizer for React",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.mjs",
    "test:ui": "playwright test",
    "build:demo": "npm run build && npm --prefix examples/demo-app run build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@visx/axis": "^3.12.0",
    "@visx/curve": "^3.12.0",
    "@visx/gradient": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/legend": "^3.12.0",
    "@visx/mock-data": "^3.12.0",
    "@visx/responsive": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/text": "^3.12.0",
    "@visx/tooltip": "^3.12.0",
    "@visx/xychart": "^3.12.0",
    "date-fns": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "react-test-renderer": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "oura",
    "ring",
    "visualization",
    "react",
    "charts",
    "health",
    "sleep",
    "activity"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Ashwin Iyer",
  "license": "ISC"
}
